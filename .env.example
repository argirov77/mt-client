# Local development API base URL
# Use one of the variables below depending on the framework.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
REACT_APP_API_URL=http://127.0.0.1:8000

# Абсолютный адрес бэкенда для серверного рендеринга (Netlify env var).
# Серверу нужен абсолютный URL: относительный /api в функции не резолвится.
# Значение согласовывается с владельцем перед установкой в Netlify.
API_ORIGIN=http://127.0.0.1:8000
